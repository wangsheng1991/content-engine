{
  "site": {
    "name": "AI Research Notes",
    "tagline": "Build first, distribute second.",
    "description": "Short, reproducible write-ups of AI research and models, each one backed by a runnable artifact.",
    "name_en": "AI Research Notes",
    "tagline_en": "Build first, distribute second.",
    "description_en": "Short, reproducible write-ups of AI research and models, each one backed by a runnable artifact.",
    "baseUrl": "https://wangsheng1991.github.io/content-engine",
    "repo": "https://github.com/wangsheng1991/content-engine",
    "author": "wangsheng1991",
    "language": "zh",
    "locale": "zh-CN",
    "locale_en": "en-US"
  },
  "paths": {
    "topics": "topics",
    "templates": "templates",
    "out": "dist"
  },
  "publish": {
    "site": "github-pages",
    "sitemapRoot": true
  },
  "images": {
    "backend": "card",
    "coverBackend": "card",
    "illustrationBackend": "cloudflare",
    "card": {
      "width": 1200,
      "height": 630
    },
    "cloudflare": {
      "model": "@cf/black-forest-labs/flux-2-klein-9b",
      "steps": 4,
      "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "timeoutMs": 300000
    },
    "qwen": {
      "endpoint": "",
      "model": "qwen-image-2.1",
      "apiKeyEnv": "QWEN_API_KEY",
      "timeoutMs": 180000
    }
  },
  "huggingface": {
    "owner": "shi9214",
    "type": "dataset"
  }
}

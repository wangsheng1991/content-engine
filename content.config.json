{
  "site": {
    "name": "AI Research Notes",
    "tagline": "Build first, distribute second.",
    "description": "Short, reproducible write-ups of AI research and models, each one backed by a runnable artifact.",
    "baseUrl": "https://wangsheng1991.github.io/content-engine",
    "repo": "https://github.com/wangsheng1991/content-engine",
    "author": "wangsheng1991",
    "language": "zh",
    "locale": "zh-CN"
  },
  "paths": {
    "topics": "topics",
    "templates": "templates",
    "out": "dist"
  },
  "publish": {
    "site": "github-pages",
    "sitemapRoot": true
  },
  "images": {
    "backend": "card",
    "card": {
      "width": 1200,
      "height": 630
    },
    "qwen": {
      "endpoint": "",
      "model": "qwen-image-2.1",
      "apiKeyEnv": "QWEN_API_KEY",
      "timeoutMs": 180000
    }
  },
  "huggingface": {
    "owner": "shi9214",
    "type": "dataset"
  }
}
